#!/usr/bin/env nu

# Deterministic local validation for this fork. Run from the Nix dev shell:
#   .agents/commands/check [--full] [--macos] [--test-filter <name>]
# Outside direnv, use: nix develop -c nu .agents/commands/check ...

def run-command [program: string, args: list<string>] {
    print $"==> ($program)"
    run-external $program ...$args
}

def check-untracked-file [path: string] {
    let result = (^git diff --check --no-index /dev/null $path | complete)
    let has_output = ($result.stdout | str length) > 0 or ($result.stderr | str length) > 0
    if $result.exit_code != 1 or $has_output {
        error make {
            msg: $"git diff --check failed for untracked file: ($path)"
        }
    }
}

def main [
    --full(-f) # Also run libghostty-vt tests and typos.
    --macos(-m) # Build and test the macOS app through its Xcode wrapper.
    --test-filter: string # Pass a deterministic filter to Zig tests.
    --diff-base: string # Check changes from this Git base through HEAD.
] {
    let is_macos = $nu.os-info.name == "macos"

    # Detect whitespace errors and unresolved conflict markers without
    # modifying the working tree. Locally, include staged and unstaged tracked
    # changes; check untracked files separately. CI supplies the pull request
    # base to validate submitted commits.
    if $diff_base == null {
        run-command git [diff --check HEAD]
        let untracked_files = (^git ls-files --others --exclude-standard | lines)
        for path in $untracked_files {
            check-untracked-file $path
        }
    } else {
        run-command git [diff --check $"($diff_base)...HEAD"]
    }

    # CI runs this against a clean checkout. Include tracked and unignored
    # working-tree Zig files, but not generated dependency artifacts.
    let zig_files = (^git ls-files --cached --others --exclude-standard -- '*.zig' | lines)
    run-command zig ([fmt --check] ++ $zig_files)
    run-command prettier [--check .]
    let nix_files = (^git ls-files --cached --others --exclude-standard -- '*.nix' | lines)
    run-command alejandra ([--check] ++ $nix_files)
    if $is_macos {
        run-command swiftlint [lint --strict]
    }

    if $test_filter == null {
        # An explicit empty filter runs all Zig unit tests without attaching
        # Xcode tests; those are covered by the macOS mode below.
        let test_args = if $is_macos {
            [build test "-Dtest-filter="]
        } else {
            [build test]
        }
        run-command zig $test_args
    } else {
        run-command zig [build test $"-Dtest-filter=($test_filter)"]
    }

    if $full {
        if $test_filter == null {
            run-command zig [build test-lib-vt]
        } else {
            run-command zig [build test-lib-vt $"-Dtest-filter=($test_filter)"]
        }
        run-command typos []
    }

    let run_macos = $macos or ($full and $is_macos)
    if $run_macos {
        run-command zig [build -Demit-macos-app=false]
        run-command macos/build.nu [--action test]
    }
}
